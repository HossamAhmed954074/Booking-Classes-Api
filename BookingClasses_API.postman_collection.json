{
	"info": {
		"_postman_id": "booking-classes-api-collection",
		"name": "Booking Classes API",
		"description": "Complete API collection for Booking Classes platform with authentication, business management, class sessions, bookings, instructors, and credits",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{authToken}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
